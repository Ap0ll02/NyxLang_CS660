Grammar

    0 $accept: program $end

    1 primary_expression: IDENTIFIER
    2                   | constant
    3                   | string
    4                   | '(' expression ')'
    5                   | generic_selection

    6 constant: I_CONSTANT
    7         | F_CONSTANT
    8         | ENUMERATION_CONSTANT

    9 enumeration_constant: IDENTIFIER

   10 string: STRING_LITERAL
   11       | FUNC_NAME

   12 generic_selection: GENERIC '(' assignment_expression ',' generic_assoc_list ')'

   13 generic_assoc_list: generic_association
   14                   | generic_assoc_list ',' generic_association

   15 generic_association: type_name ':' assignment_expression
   16                    | DEFAULT ':' assignment_expression

   17 postfix_expression: primary_expression
   18                   | postfix_expression '[' expression ']'
   19                   | postfix_expression '(' ')'
   20                   | postfix_expression '(' argument_expression_list ')'
   21                   | postfix_expression '.' IDENTIFIER
   22                   | postfix_expression PTR_OP IDENTIFIER
   23                   | postfix_expression INC_OP
   24                   | postfix_expression DEC_OP
   25                   | '(' type_name ')' '{' initializer_list '}'
   26                   | '(' type_name ')' '{' initializer_list ',' '}'

   27 argument_expression_list: assignment_expression
   28                         | argument_expression_list ',' assignment_expression

   29 unary_expression: postfix_expression
   30                 | INC_OP unary_expression
   31                 | DEC_OP unary_expression
   32                 | unary_operator cast_expression
   33                 | SIZEOF unary_expression
   34                 | SIZEOF '(' type_name ')'
   35                 | ALIGNOF '(' type_name ')'

   36 unary_operator: '&'
   37               | '*'
   38               | '+'
   39               | '-'
   40               | '~'
   41               | '!'

   42 cast_expression: unary_expression
   43                | '(' type_name ')' cast_expression

   44 multiplicative_expression: cast_expression
   45                          | multiplicative_expression '*' cast_expression
   46                          | multiplicative_expression '/' cast_expression
   47                          | multiplicative_expression '%' cast_expression

   48 additive_expression: multiplicative_expression
   49                    | additive_expression '+' multiplicative_expression
   50                    | additive_expression '-' multiplicative_expression

   51 shift_expression: additive_expression
   52                 | shift_expression LEFT_OP additive_expression
   53                 | shift_expression RIGHT_OP additive_expression

   54 relational_expression: shift_expression
   55                      | relational_expression '<' shift_expression
   56                      | relational_expression '>' shift_expression
   57                      | relational_expression LE_OP shift_expression
   58                      | relational_expression GE_OP shift_expression

   59 equality_expression: relational_expression
   60                    | equality_expression EQ_OP relational_expression
   61                    | equality_expression NE_OP relational_expression

   62 and_expression: equality_expression
   63               | and_expression '&' equality_expression

   64 exclusive_or_expression: and_expression
   65                        | exclusive_or_expression '^' and_expression

   66 inclusive_or_expression: exclusive_or_expression
   67                        | inclusive_or_expression '|' exclusive_or_expression

   68 logical_and_expression: inclusive_or_expression
   69                       | logical_and_expression AND_OP inclusive_or_expression

   70 logical_or_expression: logical_and_expression
   71                      | logical_or_expression OR_OP logical_and_expression

   72 conditional_expression: logical_or_expression
   73                       | logical_or_expression '?' expression ':' conditional_expression

   74 assignment_expression: conditional_expression
   75                      | unary_expression assignment_operator assignment_expression

   76 assignment_operator: '='
   77                    | MUL_ASSIGN
   78                    | DIV_ASSIGN
   79                    | MOD_ASSIGN
   80                    | ADD_ASSIGN
   81                    | SUB_ASSIGN
   82                    | LEFT_ASSIGN
   83                    | RIGHT_ASSIGN
   84                    | AND_ASSIGN
   85                    | XOR_ASSIGN
   86                    | OR_ASSIGN

   87 expression: assignment_expression
   88           | expression ',' assignment_expression

   89 constant_expression: conditional_expression

   90 declaration: declaration_specifiers ';'
   91            | declaration_specifiers init_declarator_list ';'
   92            | static_assert_declaration

   93 declaration_specifiers: storage_class_specifier declaration_specifiers
   94                       | storage_class_specifier
   95                       | type_specifier_list declaration_specifiers
   96                       | type_specifier_list
   97                       | type_qualifier declaration_specifiers
   98                       | type_qualifier
   99                       | function_specifier declaration_specifiers
  100                       | function_specifier
  101                       | alignment_specifier declaration_specifiers
  102                       | alignment_specifier

  103 init_declarator_list: init_declarator
  104                     | init_declarator_list ',' init_declarator

  105 init_declarator: declarator '=' initializer
  106                | declarator

  107 storage_class_specifier: TYPEDEF
  108                        | EXTERN
  109                        | STATIC
  110                        | THREAD_LOCAL
  111                        | AUTO
  112                        | REGISTER

  113 type_specifier_list: type_specifier_list type_specifier
  114                    | type_specifier

  115 type_specifier: VOID
  116               | CHAR
  117               | SHORT
  118               | INT
  119               | LONG
  120               | FLOAT
  121               | DOUBLE
  122               | SIGNED
  123               | UNSIGNED
  124               | BOOL
  125               | COMPLEX
  126               | IMAGINARY
  127               | atomic_type_specifier
  128               | struct_or_union_specifier
  129               | enum_specifier
  130               | TYPEDEF_NAME

  131 struct_or_union_specifier: struct_or_union '{' struct_declaration_list '}'
  132                          | struct_or_union IDENTIFIER '{' struct_declaration_list '}'
  133                          | struct_or_union IDENTIFIER

  134 struct_or_union: STRUCT
  135                | UNION

  136 struct_declaration_list: struct_declaration
  137                        | struct_declaration_list struct_declaration

  138 struct_declaration: specifier_qualifier_list ';'
  139                   | specifier_qualifier_list struct_declarator_list ';'
  140                   | static_assert_declaration

  141 specifier_qualifier_list: type_specifier specifier_qualifier_list
  142                         | type_specifier
  143                         | type_qualifier specifier_qualifier_list
  144                         | type_qualifier

  145 struct_declarator_list: struct_declarator
  146                       | struct_declarator_list ',' struct_declarator

  147 struct_declarator: ':' constant_expression
  148                  | declarator ':' constant_expression
  149                  | declarator

  150 enum_specifier: ENUM '{' enumerator_list '}'
  151               | ENUM '{' enumerator_list ',' '}'
  152               | ENUM IDENTIFIER '{' enumerator_list '}'
  153               | ENUM IDENTIFIER '{' enumerator_list ',' '}'
  154               | ENUM IDENTIFIER

  155 enumerator_list: enumerator
  156                | enumerator_list ',' enumerator

  157 enumerator: enumeration_constant '=' constant_expression
  158           | enumeration_constant

  159 atomic_type_specifier: ATOMIC '(' type_name ')'

  160 type_qualifier: CONST
  161               | RESTRICT
  162               | VOLATILE
  163               | ATOMIC

  164 function_specifier: INLINE
  165                   | NORETURN

  166 alignment_specifier: ALIGNAS '(' type_name ')'
  167                    | ALIGNAS '(' constant_expression ')'

  168 declarator: pointer direct_declarator
  169           | direct_declarator

  170 direct_declarator: IDENTIFIER
  171                  | '(' declarator ')'
  172                  | direct_declarator '[' ']'
  173                  | direct_declarator '[' '*' ']'
  174                  | direct_declarator '[' STATIC type_qualifier_list assignment_expression ']'
  175                  | direct_declarator '[' STATIC assignment_expression ']'
  176                  | direct_declarator '[' type_qualifier_list '*' ']'
  177                  | direct_declarator '[' type_qualifier_list STATIC assignment_expression ']'
  178                  | direct_declarator '[' type_qualifier_list assignment_expression ']'
  179                  | direct_declarator '[' type_qualifier_list ']'
  180                  | direct_declarator '[' assignment_expression ']'
  181                  | direct_declarator '(' parameter_type_list ')'
  182                  | direct_declarator '(' ')'
  183                  | direct_declarator '(' identifier_list ')'

  184 pointer: '*' type_qualifier_list pointer
  185        | '*' type_qualifier_list
  186        | '*' pointer
  187        | '*'

  188 type_qualifier_list: type_qualifier
  189                    | type_qualifier_list type_qualifier

  190 parameter_type_list: parameter_list ',' ELLIPSIS
  191                    | parameter_list

  192 parameter_list: parameter_declaration
  193               | parameter_list ',' parameter_declaration

  194 parameter_declaration: declaration_specifiers declarator
  195                      | declaration_specifiers abstract_declarator
  196                      | declaration_specifiers

  197 identifier_list: IDENTIFIER
  198                | identifier_list ',' IDENTIFIER

  199 type_name: specifier_qualifier_list abstract_declarator
  200          | specifier_qualifier_list

  201 abstract_declarator: pointer direct_abstract_declarator
  202                    | pointer
  203                    | direct_abstract_declarator

  204 direct_abstract_declarator: '(' abstract_declarator ')'
  205                           | '[' ']'
  206                           | '[' '*' ']'
  207                           | '[' STATIC type_qualifier_list assignment_expression ']'
  208                           | '[' STATIC assignment_expression ']'
  209                           | '[' type_qualifier_list STATIC assignment_expression ']'
  210                           | '[' type_qualifier_list assignment_expression ']'
  211                           | '[' type_qualifier_list ']'
  212                           | '[' assignment_expression ']'
  213                           | direct_abstract_declarator '[' ']'
  214                           | direct_abstract_declarator '[' '*' ']'
  215                           | direct_abstract_declarator '[' STATIC type_qualifier_list assignment_expression ']'
  216                           | direct_abstract_declarator '[' STATIC assignment_expression ']'
  217                           | direct_abstract_declarator '[' type_qualifier_list assignment_expression ']'
  218                           | direct_abstract_declarator '[' type_qualifier_list STATIC assignment_expression ']'
  219                           | direct_abstract_declarator '[' type_qualifier_list ']'
  220                           | direct_abstract_declarator '[' assignment_expression ']'
  221                           | '(' ')'
  222                           | '(' parameter_type_list ')'
  223                           | direct_abstract_declarator '(' ')'
  224                           | direct_abstract_declarator '(' parameter_type_list ')'

  225 initializer: '{' initializer_list '}'
  226            | '{' initializer_list ',' '}'
  227            | assignment_expression

  228 initializer_list: initializer

  229 static_assert_declaration: STATIC_ASSERT '(' constant_expression ',' STRING_LITERAL ')' ';'

  230 statement: labeled_statement
  231          | compound_statement
  232          | expression_statement
  233          | selection_statement
  234          | iteration_statement
  235          | jump_statement

  236 labeled_statement: IDENTIFIER ':' statement
  237                  | CASE constant_expression ':' statement
  238                  | DEFAULT ':' statement

  239 compound_statement: '{' '}'
  240                   | '{' block_item_list '}'

  241 block_item_list: block_item
  242                | block_item_list block_item

  243 block_item: declaration
  244           | statement

  245 expression_statement: ';'
  246                     | expression ';'

  247 selection_statement: IF '(' expression ')' statement ELSE statement
  248                    | IF '(' expression ')' statement
  249                    | IF expression compound_statement ELSE compound_statement
  250                    | IF expression compound_statement
  251                    | SWITCH '(' expression ')' statement
  252                    | SWITCH expression compound_statement

  253 iteration_statement: WHILE '(' expression ')' statement
  254                    | WHILE expression compound_statement
  255                    | DO statement WHILE '(' expression ')' ';'
  256                    | FOR expression_statement expression_statement compound_statement
  257                    | FOR expression_statement expression_statement expression_statement compound_statement
  258                    | FOR declaration expression_statement expression compound_statement
  259                    | FOR declaration expression_statement compound_statement
  260                    | FOR '(' expression_statement expression_statement ')' statement
  261                    | FOR '(' expression_statement expression_statement expression ')' statement
  262                    | FOR '(' declaration expression_statement ')' statement
  263                    | FOR '(' declaration expression_statement expression ')' statement

  264 jump_statement: GOTO IDENTIFIER ';'
  265               | CONTINUE ';'
  266               | BREAK ';'
  267               | RETURN ';'
  268               | RETURN expression ';'

  269 program: translation_unit

  270 translation_unit: external_declaration
  271                 | translation_unit external_declaration

  272 external_declaration: function_definition
  273                     | declaration

  274 function_definition: declaration_specifiers declarator declaration_list compound_statement
  275                    | declaration_specifiers declarator compound_statement

  276 declaration_list: declaration
  277                 | declaration_list declaration


