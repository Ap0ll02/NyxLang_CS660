int IterFibonacci(int x) {
    int val1 = 0;
    int val2 = 1;
    int temp = val1;

    for(int i = 0; i <= x; i++) {
        temp = val1;
        val1 = val1 + val2;
        val2 = temp;
    }
    return val1;
}

int main() {
    printf("============\n");
    printf("Iterative Fibonacci\n");
    printf("============\n");

    printf("%d\n\n", IterFibonacci(2));
}
