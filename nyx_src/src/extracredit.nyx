struct Josh {
    int value;
};

int foo() {
    return 42;
}

int main() {


    // Assignment
    int y = 25;
    printf("Value of y: %d\n", y); // Should print 25

    // Struct declaration and usage
    int z = 10;
    struct Josh n = { .value = z };
    printf("Josh value: %d\n", n.value); // Should print 10

    int y = 2;
    if y < 1 {
        int x = 5;
    }

    while y < 1 {
        int x = 6;
    }
    
    return 0;
}