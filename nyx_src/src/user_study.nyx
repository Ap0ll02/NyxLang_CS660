int main() {
    printf("Test 1: While With Parens:\n");
    int x = 0;
    while(x < 10) {
        printf("Parens: %d\n", x);
        x = x + 1;
    }

    x = 0;
    printf("Test 2: While WithOUT Parens:\n");
    while x < 10 {
        printf("W/o Parens: %d\n", x);
        x = x + 1;
    }

    printf("Test 3: For With Parens:\n");
    for(int i = 0; i < 10; i++) {
        printf("We loop again\n");
    }

    printf("Test 4: For WithOUT Parens:\n");
    for int j = 0; j < 10; j++ {
        printf("Printing The Unparend For Loop\n");
    }
}
